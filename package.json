{
  "name": "sinf-quiz",
  "private": true,
  "version": "7.46.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-python-runtime.mjs",
    "predev": "node scripts/copy-python-runtime.mjs",
    "prebuild": "node scripts/copy-python-runtime.mjs",
    "prestart": "node scripts/copy-python-runtime.mjs",
    "dev": "node scripts/dev-ai.mjs",
    "dev:web": "vite",
    "ai:check": "node scripts/ai-check.mjs",
    "ai:check:speaking": "node scripts/ai-check.mjs --speaking",
    "test:ai": "node --test tests/ai-*.test.js tests/speaking-*.test.js tests/local-admin-api.test.js",
    "test:e2e:ai": "node tests/ai-assistant-browser.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/dev-ai.mjs --host 0.0.0.0",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "test:e2e:competition": "node tests/competition-browser.cjs && node tests/competition-attendance-browser.cjs && node tests/competition-free-browser.cjs",
    "test:load:competition": "node tests/competition-load.mjs",
    "test:load:competition-free": "node tests/competition-free-load.mjs",
    "test:e2e:learning": "node tests/learning-browser.cjs",
    "test:e2e:studio": "node tests/studio-browser.cjs",
    "test:e2e:science": "node tests/science-studio-browser.cjs",
    "test:e2e:play": "node tests/secure-play-browser.cjs",
    "test:e2e:classroom": "node tests/classroom-browser.cjs",
    "test:e2e:space": "node tests/space-browser.cjs",
    "test:e2e:physical": "node tests/physical-browser.cjs",
    "perf": "node scripts/measure-performance.mjs dist --check",
    "test:e2e:informatics": "node tests/informatics-browser.mjs",
    "test:e2e:atlases": "node tests/atlas-learning-browser.mjs",
    "test:e2e:reality": "node tests/atlas-reality-browser.mjs",
    "test:e2e:informatics-models": "node tests/informatics-models-browser.mjs",
    "worker:speaking": "node --env-file=.env.local scripts/speaking-worker.mjs",
    "test:speaking": "node --test tests/speaking-*.test.js"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@supabase/supabase-js": "^2.57.4",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.45.0",
    "pyodide": "0.29.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.180.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "playwright": "1.62.1"
  }
}
