# Public configuration. Set the values for your own project in .env.local.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key
VITE_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# AI Speaking: server / worker only. Never use a VITE_ prefix for these.
GROQ_API_KEY=replace_with_new_server_side_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASSESSMENT_MODEL=openai/gpt-oss-120b
GROQ_PRACTICE_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_PRACTICE_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
SPEAKING_FFPROBE_PATH=ffprobe
# Optional localhost Speaking models. Use absolute paths on Windows.
# SPEAKING_PROVIDER=local
# SPEAKING_LOCAL_LLM_URL=http://127.0.0.1:17863
# SPEAKING_LOCAL_LLM_PATH=C:/SinfQuizAI/llama-server.exe
# SPEAKING_LOCAL_LLM_WEIGHTS=C:/SinfQuizAI/qwen3.5-4b-Q4_K_M.gguf
# SPEAKING_LOCAL_WHISPER_PATH=C:/SinfQuizAI/whisper-cli.exe
# SPEAKING_LOCAL_WHISPER_MODEL=C:/SinfQuizAI/ggml-small.en-q5_1.bin
# SPEAKING_LOCAL_FFMPEG_PATH=C:/SinfQuizAI/ffmpeg.exe
# Optional credentials for scripts/cloudflare-speaking-check.mjs.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
SPEAKING_MAX_UPLOAD_MB=20
SPEAKING_AUDIO_RETENTION_DAYS=30
SPEAKING_USER_AI_CALLS=80
SPEAKING_SITE_AI_CALLS=2000
SPEAKING_USER_TOKEN_BUDGET=250000
SPEAKING_SITE_TOKEN_BUDGET=5000000
SPEAKING_USER_AUDIO_SECONDS=5400
SPEAKING_SITE_AUDIO_SECONDS=100000
SPEAKING_USER_UPLOAD_KIB=102400
SPEAKING_SITE_UPLOAD_KIB=2097152
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
